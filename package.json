{
  "name": "dsh-wechat-clawbot-fix",
  "version": "0.3.2-fix.1",
  "description": "DSH bundle: WeChat ClawBot bridge (QR login, relay, remote approval) - patched fork for DSH 0.2.x",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./dsh-client-wechat-ui/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "dsh-wechat-bot",
    "dsh-client-wechat-ui",
    "dsh-wechat-bridge",
    "wechat-gateway",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test dsh-wechat-bot/probe.test.mjs dsh-wechat-bot/keepalive.test.mjs wechat-gateway/window.test.mjs && node dsh-wechat-bridge/settle.test.mjs && node dsh-wechat-bridge/approval.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "engines": {
      "dsh": ">=0.1.5-rc.1"
    },
    "client": {
      "platform": "web"
    }
  },
  "dependencies": {
    "qrcode": "^1.5.4"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "wechat",
    "ilink"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.19"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^0.1.0-rc.6 || ^0.1.1-rc.1 || ^0.1.2-alpha.1 || ^0.1.5-rc.1",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.6 || ^0.1.1-rc.1 || ^0.1.2-alpha.1 || ^0.1.5-rc.1 || ^0.2.0-rc.2",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.6 || ^0.1.1-rc.1 || ^0.1.2-alpha.1 || ^0.1.5-rc.1 || ^0.2.0-rc.2",
    "@deepseek-ai/dsh-settings": "^0.1.0-rc.6 || ^0.1.1-rc.1 || ^0.1.2-alpha.1 || ^0.1.5-rc.1 || ^0.2.0-rc.2",
    "@deepseek-ai/schemastery": "^0.1.0-rc.6 || ^0.1.1-rc.1 || ^0.1.2-alpha.1 || ^0.1.5-rc.1"
  }
}
